# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key for token generation & verification (REQUIRED - Generate using: openssl rand -hex 32)
SECRET_KEY=your_strong_secret_key_here

# Database Configuration
DATABASE_URL=sqlite:///./teaching_platform.db
# For PostgreSQL: postgresql://user:password@localhost:5432/teaching_platform

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017

# CORS Allowed Origins (comma-separated list for frontend domains)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
